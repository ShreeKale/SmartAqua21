<%- layout("layouts/boilerplate.ejs") %>

<div class="max-w-7xl mx-auto px-6 md:px-12 py-20 lg:py-28">
    <div class="mb-16 max-w-2xl">
        <h2 class="text-3xl font-light tracking-tight text-slate-900 sm:text-4xl">Product Catalog</h2>
        <p class="mt-4 text-sm text-slate-500 font-light leading-relaxed">
            High-performance engineering solutions and purification grids built for continuous output and strict regulatory compliance.
        </p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 sm:gap-x-8 gap-y-12 sm:gap-y-16">
        <% [
            "100 LPH RO", 
            "250 LPH RO", 
            "500 LPH RO", 
            "1000 LPH RO", 
            "2000 LPH RO", 
            "4000 LPH RO",
            "2 Ton Chiller", 
            "3 Ton Chiller",
            "5 Ton Chiller",
            "DM Plant",
            "DI Plant",
            "Dosing Chemical",
            "Water ATM"
        ].forEach(p => { %>
        <div class="group flex flex-col justify-between">
            <div>
                <div class="aspect-square bg-slate-50 flex items-center justify-center p-4 sm:p-8 mb-6 border border-slate-100 rounded-xl transition-all duration-300 group-hover:border-slate-200 group-hover:shadow-sm">
                    <img src="https://www.rocareindia.com/uploads/product_image/product_452_1.jpg" 
                         class="max-h-full max-w-full object-contain transition-transform duration-500 ease-out group-hover:scale-102" 
                         alt="<%= p %>">
                </div>
                
                <div class="hidden sm:flex items-center gap-2 mb-2">
                    <span class="text-[10px] uppercase tracking-widest text-slate-400 font-medium">Precisely Assembled</span>
                    <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                    <span class="text-[10px] uppercase tracking-widest text-slate-400 font-medium">Industrial Grade</span>
                </div>
                
                <h3 class="text-base sm:text-lg font-normal tracking-tight text-slate-900 mb-2">
                    <%= p %>
                </h3>
                
                <p class="text-[11px] sm:text-xs text-slate-500 font-light leading-relaxed mb-6 line-clamp-3 sm:line-clamp-none">
                    Tuned treatment membranes against raw chemical feed compositions to safeguard secondary mechanical components.
                </p>
            </div>

            <div>
                <a href="/home#contact?product=<%= encodeURIComponent(p) %>" 
                   class="inline-block text-xs uppercase tracking-widest text-slate-900 font-medium border-b border-slate-900 pb-1 hover:text-slate-600 hover:border-slate-400 transition-colors duration-200">
                    Enquire
                </a>
            </div>
        </div>
        <% }) %>
    </div>
</div>