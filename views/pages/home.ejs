        <p id="inquiryMessage"
   class="text-slate-500 text-xs font-light mt-2 leading-relaxed">
    Thank you for reaching out. Our team will review your
    requirements and follow up shortly.
</p>
        
        <div class="mt-5">
            <button type="button" id="closeModalBtn" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-semibold py-2.5 px-4 rounded-xl text-xs transition shadow-sm focus:outline-none">
                Acknowledge
            </button>
        </div>
    </div>
