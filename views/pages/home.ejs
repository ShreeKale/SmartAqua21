<script>
    document.addEventListener("DOMContentLoaded", () => {

        const form = document.getElementById("contactForm");
        const modal = document.getElementById("successModal");
        const modalContent = document.getElementById("modalContent");
        const closeModalBtn = document.getElementById("closeModalBtn");

        const configSelects = document.querySelectorAll(".config-select");
        const selectionList = document.getElementById("selectionList");
        const clearSelectionsBtn = document.getElementById("clearSelections");


        // =========================================================
        // UPDATE SELECTED CONFIGURATIONS DISPLAY
        // =========================================================

        function updateSelectionsDisplay() {

            selectionList.innerHTML = "";

            let activeSelections = [];

            configSelects.forEach(select => {

                if (select.value) {

                    activeSelections.push({
                        selectId: select.id,
                        value: select.value
                    });

                }

            });


            if (activeSelections.length > 0) {

                clearSelectionsBtn.classList.remove("hidden");

                activeSelections.forEach(item => {

                    const badge = document.createElement("span");

                    badge.className =
                        "inline-flex items-center gap-1.5 bg-blue-50 border border-blue-100 text-blue-700 text-xs font-medium px-2.5 py-1 rounded-lg shadow-2xs";

                    badge.innerHTML = `
                        <span>${item.value}</span>

                        <button
                            type="button"
                            data-select-id="${item.selectId}"
                            class="remove-badge text-blue-400 hover:text-blue-700 font-bold ml-0.5 focus:outline-none"
                        >
                            &times;
                        </button>
                    `;

                    selectionList.appendChild(badge);

                });

            } else {

                clearSelectionsBtn.classList.add("hidden");

                const placeholder = document.createElement("span");

                placeholder.className =
                    "text-xs text-slate-400 italic";

                placeholder.textContent =
                    "No equipment selected yet. Choose options above.";

                selectionList.appendChild(placeholder);
            }
        }


        // =========================================================
        // NORMAL DROPDOWN CHANGE
        // =========================================================

        configSelects.forEach(select => {

            select.addEventListener(
                "change",
                updateSelectionsDisplay
            );

        });


        // =========================================================
        // REMOVE INDIVIDUAL SELECTION
        // =========================================================

        selectionList.addEventListener("click", (e) => {

            if (e.target.classList.contains("remove-badge")) {

                const targetSelectId =
                    e.target.getAttribute("data-select-id");

                const targetSelect =
                    document.getElementById(targetSelectId);

                if (targetSelect) {

                    targetSelect.value = "";

                    updateSelectionsDisplay();
                }
            }

        });


        // =========================================================
        // CLEAR ALL
        // =========================================================

        if (clearSelectionsBtn) {

            clearSelectionsBtn.addEventListener("click", () => {

                configSelects.forEach(select => {
                    select.value = "";
                });

                updateSelectionsDisplay();

            });

        }


        // =========================================================
        // AUTO SELECT PRODUCT FROM PRODUCT PAGE
        // =========================================================

        const urlParams = new URLSearchParams(window.location.search);

        const selectedProduct = urlParams.get("product");


        if (selectedProduct) {

            console.log("Product received from catalog:", selectedProduct);


            // ---------------------------------------------
            // RO PLANT
            // ---------------------------------------------

            if (selectedProduct.includes("RO Plant")) {

                const roSelect =
                    document.getElementById("roPlant");

                if (roSelect) {

                    const matchingOption =
                        Array.from(roSelect.options).find(
                            option => option.value === selectedProduct
                        );

                    if (matchingOption) {
                        roSelect.value = selectedProduct;
                    }
                }
            }


            // ---------------------------------------------
            // DM PLANT
            // ---------------------------------------------

            else if (selectedProduct.includes("DM Plant")) {

                const dmSelect =
                    document.getElementById("dmPlant");

                if (dmSelect) {

                    const matchingOption =
                        Array.from(dmSelect.options).find(
                            option => option.value === selectedProduct
                        );

                    if (matchingOption) {
                        dmSelect.value = selectedProduct;
                    }
                }
            }


            // ---------------------------------------------
            // WATER CHILLER
            // ---------------------------------------------

            else if (selectedProduct.includes("Water Chiller")) {

                const chillerSelect =
                    document.getElementById("waterChiller");

                if (chillerSelect) {

                    const matchingOption =
                        Array.from(chillerSelect.options).find(
                            option => option.value === selectedProduct
                        );

                    if (matchingOption) {
                        chillerSelect.value = selectedProduct;
                    }
                }
            }


            // ---------------------------------------------
            // WATER SOFTENER
            // ---------------------------------------------

            else if (
                selectedProduct.includes("Water Softener") ||
                selectedProduct.includes("Softener")
            ) {

                const softenerSelect =
                    document.getElementById("waterSoftener");

                if (softenerSelect) {

                    const matchingOption =
                        Array.from(softenerSelect.options).find(
                            option => option.value === selectedProduct
                        );

                    if (matchingOption) {
                        softenerSelect.value = selectedProduct;
                    }
                }
            }


            // ---------------------------------------------
            // UPDATE VISUAL SELECTION BOARD
            // ---------------------------------------------

            updateSelectionsDisplay();

        }


        // =========================================================
        // SUCCESS MODAL
        // =========================================================

        function showModal() {

            modal.classList.remove("hidden");

            setTimeout(() => {

                modalContent.classList.remove(
                    "scale-95",
                    "opacity-0"
                );

                modalContent.classList.add(
                    "scale-100",
                    "opacity-100"
                );

            }, 10);
        }


        function hideModal() {

            modalContent.classList.remove(
                "scale-100",
                "opacity-100"
            );

            modalContent.classList.add(
                "scale-95",
                "opacity-0"
            );

            setTimeout(() => {

                modal.classList.add("hidden");

            }, 300);
        }


        closeModalBtn.addEventListener(
            "click",
            hideModal
        );


        // =========================================================
        // FORM SUBMISSION
        // =========================================================

        
// =========================================================
// FORM SUBMISSION
// =========================================================

if (form) {
    const submitButton = form.querySelector(
        'button[type="submit"]'
    );
    const inquiryMessage = document.getElementById(
        "inquiryMessage"
    );

    form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!form.reportValidity()) {
            return;
        }

        const originalButtonText = submitButton.textContent;
        submitButton.disabled = true;
        submitButton.textContent = "Submitting...";

        try {
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());

            const response = await fetch("/submit-form", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (!response.ok || !result.success) {
                alert(
                    result.message ||
                    "Unable to submit your inquiry. Please try again."
                );
                return;
            }

            if (inquiryMessage) {
                inquiryMessage.textContent = result.emailSent
                    ? "Thank you! Your inquiry has been received, and confirmation emails have been sent."
                    : "Thank you! Your inquiry has been saved. Email delivery is currently delayed, but our team can follow up.";
            }

            showModal();
            form.reset();
            updateSelectionsDisplay();
        } catch (error) {
            console.error("Submission error:", error);

            alert(
                "A network error occurred. Please check your connection and try again."
            );
        } finally {
            submitButton.disabled = false;
            submitButton.textContent = originalButtonText;
        }
    });
}

    });
</script>