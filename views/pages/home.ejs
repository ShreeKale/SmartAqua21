<%- layout("layouts/boilerplate.ejs") %>

<section class="py-40 px-6 bg-stone-100 text-stone-900 relative overflow-hidden">
    <div class="max-w-6xl mx-auto relative z-10 grid md:grid-cols-12 gap-16 items-center">
        <div class="md:col-span-7 max-w-2xl">
            <div class="flex items-center gap-3 mb-8">
                <svg class="w-8 h-8 text-blue-900" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L2 12h3v8h6v-6h2v6h6v-8h3L12 2z" fill="currentColor" opacity="0.15"/>
                    <path d="M12 4.5L4.5 12H7v7h4v-5h2v5h4v-7h2.5L12 4.5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="12" cy="11" r="1.5" fill="currentColor"/>
                </svg>
                <span class="text-xs uppercase tracking-[0.3em] font-semibold text-stone-800">Smart Aqua</span>
            </div>
            
            <h1 class="text-5xl md:text-7xl font-serif font-light leading-tight mb-8 text-stone-900">
                The Standard in <br> <span class="italic font-normal text-blue-900">Industrial Purity</span>
            </h1>
            <p class="text-stone-600 font-light text-lg leading-relaxed mb-12 max-w-xl">
                Architecting advanced fluid separation systems and precision thermal control units for mission-critical industrial facilities across the globe.
            </p>
            <a href="#contact" class="inline-flex items-center gap-3 border-b border-stone-900 pb-1 text-xs uppercase tracking-[0.2em] font-medium text-stone-900 hover:text-blue-900 hover:border-blue-900 transition duration-300">
                Initiate Engineering Review <span>&rarr;</span>
            </a>
        </div>
        <div class="md:col-span-5 h-[450px]">
            <img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=800&q=80" alt="Industrial Water Laboratory and Processing" class="w-full h-full object-cover rounded-2xl filter grayscale brightness-95 contrast-105 hover:grayscale-0 transition duration-700 shadow-xl">
        </div>
    </div>
</section>

<section class="py-32 bg-stone-200/60 px-6 border-y border-stone-300/50">
    <div class="max-w-6xl mx-auto grid md:grid-cols-12 gap-16 items-center">
        <div class="md:col-span-5 h-[500px] hidden md:block">
            <img src="https://images.unsplash.com/photo-1617155093730-a8bf47be792d?auto=format&fit=crop&w=800&q=80" alt="Pure Water Mechanics" class="w-full h-full object-cover rounded-2xl shadow-xl filter contrast-110">
        </div>
        <div class="md:col-span-7">
            <h2 class="text-xs uppercase tracking-[0.3em] text-blue-900 mb-6 font-semibold">Corporate Profile</h2>
            <h3 class="text-3xl md:text-4xl font-serif font-light text-stone-900 leading-snug mb-8">
                Uncompromising engineering <br>built for <span class="italic text-blue-900">generational performance.</span>
            </h3>
            <p class="text-stone-700 font-light leading-relaxed mb-6">
                PureFlow Technologies designs, constructs, and deploys scalable high-capacity Reverse Osmosis frameworks. We operate at the intersection of environmental responsibility and heavy-duty utility output, optimizing recovery rates while reducing energy expenditures.
            </p>
            <p class="text-stone-700 font-light leading-relaxed">
                From pre-treatment analytical auditing to turn-key mechanical assembly and responsive maintenance architecture, our lifespans are measured in decades.
            </p>
        </div>
    </div>
</section>

<section class="py-32 bg-stone-100 px-6">
    <div class="max-w-6xl mx-auto">
        <div class="mb-20">
            <h2 class="text-xs uppercase tracking-[0.3em] text-stone-500 mb-4 font-medium">Core Capabilities</h2>
            <h3 class="text-3xl font-serif font-light text-stone-900">Sector Specializations</h3>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-10">
            <% 
            const applications = [
                { title: "Healthcare & Dialysis", img: "https://images.unsplash.com/photo-1584515933487-7804d6688864?auto=format&fit=crop&w=600&q=80" },
                { title: "Manufacturing & Heavy Sector", img: "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=600&q=80" },
                { title: "Chemical & Processing", img: "https://images.unsplash.com/photo-1532187863486-abf9d39d66e8?auto=format&fit=crop&w=600&q=80" },
                { title: "Educational & Research Labs", img: "https://images.unsplash.com/photo-1576086213369-97a306d36557?auto=format&fit=crop&w=600&q=80" },
                { title: "Hospitality & Food Production", img: "https://images.unsplash.com/photo-1556910103-1c02745aae4d?auto=format&fit=crop&w=600&q=80" },
                { title: "Municipal Infrastructure", img: "https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&w=600&q=80" }
            ];
            applications.forEach((app, index) => { 
            %>
                <div class="group transition-all duration-300">
                    <div class="h-56 overflow-hidden mb-6 bg-stone-200 rounded-2xl shadow-md">
                        <img src="<%= app.img %>" alt="<%= app.title %>" class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 group-hover:scale-105 transition duration-500">
                    </div>
                    <div class="flex justify-between items-center px-1">
                        <h4 class="text-sm uppercase tracking-wider font-medium text-stone-900"><%= app.title %></h4>
                        <span class="text-stone-400 font-serif text-xs">/ 0<%= index + 1 %></span>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</section>

<section id="contact" class="py-36 px-6 bg-stone-200 text-stone-900 border-t border-stone-300/60">
    <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-12 gap-20 items-start">
            
            <div class="lg:col-span-7">
                <div class="mb-16">
                    <h2 class="text-4xl font-serif font-light tracking-wide text-stone-900 mb-3">Quotation Request</h2>
                    <p class="text-xs uppercase tracking-[0.25em] text-blue-900 font-medium">Custom System Specification Suite</p>
                </div>

                <form id="contactForm" class="space-y-12">
                    <div class="grid md:grid-cols-2 gap-10">
                        <div class="relative">
                            <label class="block text-[11px] uppercase tracking-[0.15em] text-stone-500 mb-1">Full Name</label>
                            <input type="text" id="name" name="name" class="w-full border-b border-stone-400 py-2 focus:outline-none focus:border-blue-900 transition bg-transparent font-light text-stone-950" required>
                        </div>
                        <div class="relative">
                            <label class="block text-[11px] uppercase tracking-[0.15em] text-stone-500 mb-1">Mobile Number</label>
                            <input type="tel" id="phone" name="phone" class="w-full border-b border-stone-400 py-2 focus:outline-none focus:border-blue-900 transition bg-transparent font-light text-stone-950" required>
                        </div>
                    </div>

                    <div>
                        <label class="block text-[11px] uppercase tracking-[0.15em] text-stone-500 mb-1">Installation Site Address</label>
                        <textarea id="address" name="address" class="w-full border-b border-stone-400 py-2 focus:outline-none focus:border-blue-900 transition bg-transparent font-light text-stone-950" rows="2" required></textarea>
                    </div>

                    <div class="grid md:grid-cols-2 gap-10 pt-6 border-t border-stone-300">
                        <div>
                            <h5 class="text-xs uppercase tracking-[0.2em] font-semibold text-stone-800 mb-6">1. RO Plant Capacity</h5>
                            <div class="space-y-3">
                                <% ["500 LPH", "1000 LPH", "2000 LPH"].forEach((val, i) => { %>
                                    <label class="flex items-center gap-3 cursor-pointer group">
                                        <input type="radio" name="roPlant" value="<%= val %>" class="w-3.5 h-3.5 accent-blue-900 bg-stone-300 border-stone-400" <%= i==0?'checked':'' %>>
                                        <span class="text-xs uppercase tracking-wider text-stone-600 group-hover:text-stone-950 transition"><%= val %> Unit</span>
                                    </label>
                                <% }) %>
                            </div>
                        </div>
                        <div>
                            <h5 class="text-xs uppercase tracking-[0.2em] font-semibold text-stone-800 mb-6">2. Chiller Capacity</h5>
                            <div class="space-y-3">
                                <% ["2 Ton", "3 Ton", "5 Ton"].forEach((val, i) => { %>
                                    <label class="flex items-center gap-3 cursor-pointer group">
                                        <input type="radio" name="chiller" value="<%= val %>" class="w-3.5 h-3.5 accent-blue-900 bg-stone-300 border-stone-400" <%= i==0?'checked':'' %>>
                                        <span class="text-xs uppercase tracking-wider text-stone-600 group-hover:text-stone-950 transition"><%= val %> Unit</span>
                                    </label>
                                <% }) %>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4">
                        <button type="submit" class="bg-stone-900 text-white px-16 py-4 text-[11px] uppercase tracking-[0.25em] hover:bg-blue-900 transition duration-300 font-medium tracking-widest shadow-md">
                            Submit Inquiry
                        </button>
                    </div>
                </form>
            </div>

            <div class="lg:col-span-5 lg:pl-12 lg:border-l border-stone-300 space-y-12 self-end pb-4">
                <div>
                    <h4 class="text-xs uppercase tracking-[0.25em] text-blue-900 font-semibold mb-4">Corporate Headquarters</h4>
                    <p class="text-stone-700 font-light text-sm leading-relaxed uppercase tracking-wider">
                        Smart Technology & Multi Services<br>
                        Shendra MIDC<br>
                        Chh. Sambhajinagar
                    </p>
                </div>
                
                <div>
                    <h4 class="text-xs uppercase tracking-[0.25em] text-blue-900 font-semibold mb-4">Direct Lines</h4>
                    <p class="text-stone-700 font-light text-sm uppercase tracking-wider space-y-1">
                        <span class="block">T: +91 94235 14131</span>
                        <span class="block"></span>
                    </p>
                </div>

                <div>
                    <h4 class="text-xs uppercase tracking-[0.25em] text-blue-900 font-semibold mb-4">Digital Communications</h4>
                    <a href="mailto:solutions@pureflowtech.com" class="text-stone-700 font-light text-sm hover:text-blue-900 transition border-b border-stone-400 pb-0.5 tracking-wide">
                        smartaqua1212@gmail.com
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
    document.getElementById("contactForm").addEventListener("submit", async (e) => {
        e.preventDefault();
        const body = {
            name: document.getElementById("name").value,
            phone: document.getElementById("phone").value,
            address: document.getElementById("address").value,
            roPlant: document.querySelector('input[name="roPlant"]:checked').value,
            chiller: document.querySelector('input[name="chiller"]:checked').value
        };
        const res = await fetch("/submit-form", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body)
        });
        const result = await res.json();
        if(result.success) {
            Swal.fire({ 
                title: "THANK YOU", 
                text: "Your system configuration preferences have been securely submitted.", 
                icon: "success", 
                confirmButtonColor: "#1c1917",
                customClass: { 
                    title: 'font-serif tracking-widest text-xl text-stone-900',
                    popup: 'rounded-none border border-stone-300'
                }
            });
            e.target.reset();
        }
    });
</script>