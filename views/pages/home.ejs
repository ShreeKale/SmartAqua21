                        </div>
                    </div>

                    <!-- Custom Requirement Box -->
                    <div class="space-y-1.5 pt-2">
                        <label for="customRequirement" class="text-xs font-bold text-slate-700 block">Custom Requirement / Specific Details:</label>
                        <textarea id="customRequirement" name="customRequirement" rows="3" placeholder="Describe any unique TDS levels, layout constraints, custom flow rates, or specific engineering requirements..." class="bg-slate-50 border border-slate-200 focus:border-blue-500 p-2.5 rounded-xl text-slate-900 text-sm focus:outline-none transition w-full"></textarea>
                    </div>
                </div>
            </div>

            <div class="space-y-4 border-t border-slate-100 pt-4">
                <h3 class="text-sm font-bold text-slate-900 tracking-wider uppercase pb-1">Contact Information</h3>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label for="name" class="text-[10px] font-bold text-slate-400 tracking-wider uppercase">Full Name</label>
                        <input type="text" id="name" name="name" placeholder="John Doe" class="bg-slate-50 border border-slate-200 focus:border-blue-500 p-2.5 rounded-xl text-slate-900 text-sm focus:outline-none transition" required>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label for="phone" class="text-[10px] font-bold text-slate-400 tracking-wider uppercase">Contact Number</label>
                        <input type="tel" id="phone" name="phone" placeholder="Mobile / Office Phone" class="bg-slate-50 border border-slate-200 focus:border-blue-500 p-2.5 rounded-xl text-slate-900 text-sm focus:outline-none transition" required>
                    </div>

                    <div class="flex flex-col gap-1.5 sm:col-span-2">
                        <label for="address" class="text-[10px] font-bold text-slate-400 tracking-wider uppercase">Installation Address</label>
                        <textarea id="address" name="address" rows="2" placeholder="Enter full site facility details..." class="bg-slate-50 border border-slate-200 focus:border-blue-500 p-2.5 rounded-xl text-slate-900 text-sm focus:outline-none transition" required></textarea>
                    </div>
                </div>
            </div>

            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-xl shadow transition text-sm">
                Submit Inquiry Configuration
            </button>
        </form>
    </div>
</section>

<!-- Success Modal -->
<div id="successModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 overflow-x-hidden overflow-y-auto">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity"></div>
    <div class="relative bg-white rounded-2xl border border-slate-200 max-w-sm w-full p-6 text-center shadow-2xl transform transition-all scale-95 opacity-0 duration-300" id="modalContent">
        <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-500 mb-4">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
            </svg>
        </div>
        
        <h3 class="text-lg font-bold text-slate-900 tracking-tight">Inquiry Submitted</h3>
        <p class="text-slate-500 text-xs font-light mt-2 leading-relaxed">
            Thank you for reaching out. Our industrial systems engineering team will review your specified parameters and follow up shortly.
        </p>
        
        <div class="mt-5">
            <button type="button" id="closeModalBtn" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-semibold py-2.5 px-4 rounded-xl text-xs transition shadow-sm focus:outline-none">
                Acknowledge
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("contactForm");
        const modal = document.getElementById("successModal");
        const modalContent = document.getElementById("modalContent");
        const closeModalBtn = document.getElementById("closeModalBtn");
        
        const configSelects = document.querySelectorAll(".config-select");
        const selectionList = document.getElementById("selectionList");
        const clearSelectionsBtn = document.getElementById("clearSelections");

        function updateSelectionsDisplay() {
            selectionList.innerHTML = "";
            let activeSelections = [];

            configSelects.forEach(select => {
                if (select.value) {
                    activeSelections.push({
                        selectId: select.id,
                        value: select.value
                    });
                }
            });

            if (activeSelections.length > 0) {
                clearSelectionsBtn.classList.remove("hidden");
                activeSelections.forEach(item => {
                    const badge = document.createElement("span");
                    badge.className = "inline-flex items-center gap-1.5 bg-blue-50 border border-blue-100 text-blue-700 text-xs font-medium px-2.5 py-1 rounded-lg shadow-2xs";
                    badge.innerHTML = `
                        <span>${item.value}</span>
                        <button type="button" data-select-id="${item.selectId}" class="remove-badge text-blue-400 hover:text-blue-700 font-bold ml-0.5 focus:outline-none">&times;</button>
                    `;
                    selectionList.appendChild(badge);
                });
            } else {
                clearSelectionsBtn.classList.add("hidden");
                const placeholder = document.createElement("span");
                placeholder.className = "text-xs text-slate-400 italic";
                placeholder.textContent = "No equipment selected yet. Choose options above.";
                selectionList.appendChild(placeholder);
            }
        }

        configSelects.forEach(select => {
            select.addEventListener("change", updateSelectionsDisplay);
        });

        selectionList.addEventListener("click", (e) => {
            if (e.target.classList.contains("remove-badge")) {
                const targetSelectId = e.target.getAttribute("data-select-id");
                const targetSelect = document.getElementById(targetSelectId);
                if (targetSelect) {
                    targetSelect.value = "";
                    updateSelectionsDisplay();
                }
            }
        });

        if (clearSelectionsBtn) {
            clearSelectionsBtn.addEventListener("click", () => {
                configSelects.forEach(select => {
                    select.value = "";
                });
                updateSelectionsDisplay();
            });
        }

        function showModal() {
            modal.classList.remove("hidden");
            setTimeout(() => {
                modalContent.classList.remove("scale-95", "opacity-0");
                modalContent.classList.add("scale-100", "opacity-100");
            }, 10);
        }

        function hideModal() {
            modalContent.classList.remove("scale-100", "opacity-100");
            modalContent.classList.add("scale-95", "opacity-0");
            setTimeout(() => {
                modal.classList.add("hidden");
            }, 300);
        }

        if (form) {
            form.addEventListener("submit", (e) => {
                e.preventDefault();
                showModal();
                form.reset();
                updateSelectionsDisplay();
            });
        }

        if (closeModalBtn) {
            closeModalBtn.addEventListener("click", hideModal);
        }
    });
</script>