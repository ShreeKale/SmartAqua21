<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-100">

<!-- HEADER -->
<div class="bg-white border-b">
    <div class="max-w-7xl mx-auto px-6 py-5 flex justify-between">

        <div>
            <h1 class="text-xl font-semibold">Client Enquiries</h1>
            <p class="text-sm text-slate-500">Smart Aqua CRM</p>
        </div>

        <div class="flex gap-4">
            <a href="/admin/logout" class="text-red-500">Logout</a>
        </div>

    </div>
</div>

<!-- TABLE -->
<div class="max-w-7xl mx-auto px-6 py-10">

    <div class="bg-white rounded-xl shadow overflow-x-auto">

        <table class="w-full text-left">

            <thead class="bg-slate-50 text-xs uppercase">
                <tr>
                    <th class="p-4">Name</th>
                    <th class="p-4">Phone</th>
                    <th class="p-4">Address</th>
                    <th class="p-4">RO Plants</th>
                    <th class="p-4">DM Plants</th>
                    <th class="p-4">Chillers</th>
                    <th class="p-4">Softeners</th>
                    <th class="p-4">Custom Requirement</th>
                    <th class="p-4">Date</th>
                    <th class="p-4">Action</th>
                </tr>
            </thead>

            <tbody>

                <% submissions.forEach(s => { %>
                <tr class="border-t align-top">

                    <td class="p-4 font-medium"><%= s.name %></td>
                    <td class="p-4"><%= s.phone %></td>
                    <td class="p-4"><%= s.address %></td>

                    <!-- RO PLANTS -->
                    <td class="p-4">
                        <% if (s.selections?.roPlants?.length) { %>
                            <% s.selections.roPlants.forEach(v => { %>
                                <span class="bg-blue-100 text-blue-700 px-2 py-1 rounded text-xs mr-1 inline-block mb-1">
                                    <%= v %>
                                </span>
                            <% }) %>
                        <% } else { %> N/A <% } %>
                    </td>

                    <!-- DM PLANTS -->
                    <td class="p-4">
                        <% if (s.selections?.dmPlants?.length) { %>
                            <% s.selections.dmPlants.forEach(v => { %>
                                <span class="bg-amber-100 text-amber-700 px-2 py-1 rounded text-xs mr-1 inline-block mb-1">
                                    <%= v %>
                                </span>
                            <% }) %>
                        <% } else { %> N/A <% } %>
                    </td>

                    <!-- CHILLERS -->
                    <td class="p-4">
                        <% if (s.selections?.chillers?.length) { %>
                            <% s.selections.chillers.forEach(v => { %>
                                <span class="bg-slate-200 text-slate-700 px-2 py-1 rounded text-xs mr-1 inline-block mb-1">
                                    <%= v %>
                                </span>
                            <% }) %>
                        <% } else { %> N/A <% } %>
                    </td>

                    <!-- SOFTENERS -->
                    <td class="p-4">
                        <% if (s.selections?.softeners?.length) { %>
                            <% s.selections.softeners.forEach(v => { %>
                                <span class="bg-green-100 text-green-700 px-2 py-1 rounded text-xs mr-1 inline-block mb-1">
                                    <%= v %>
                                </span>
                            <% }) %>
                        <% } else { %> N/A <% } %>
                    </td>

                    <!-- CUSTOM REQUIREMENT -->
                    <td class="p-4 text-xs text-slate-600 max-w-xs break-words">
                        <% if (s.customRequirement && s.customRequirement.trim() !== "") { %>
                            <%= s.customRequirement %>
                        <% } else { %>
                            <span class="text-slate-400 italic">None</span>
                        <% } %>
                    </td>

                    <td class="p-4 text-sm text-slate-500 whitespace-nowrap">
                        <%= s.date.toDateString() %>
                    </td>

                    <td class="p-4 whitespace-nowrap">
                        <form action="/delete/<%= s._id %>" method="POST">
                            <button class="text-red-500 text-sm hover:underline">Delete</button>
                        </form>
                    </td>

                </tr>
                <% }) %>

            </tbody>

        </table>

    </div>

</div>

</body>
</html>