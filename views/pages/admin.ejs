<!DOCTYPE html>
<html>
<head>
    <title>Admin – Submissions</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="bg-light">

<div class="container mt-5">
    <h2 class="mb-4">User Enquiries</h2>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>System Type</th>
                <th>Message</th>
                <th>Date</th>
            </tr>
        </thead>

        <tbody>
            <% submissions.forEach(s => { %>
                <tr>
                    <td><%= s.name %></td>
                    <td><%= s.phone %></td>
                    <td><%= s.email %></td>
                    <td><%= s.systemType %></td>
                    <td><%= s.message %></td>
                    <td><%= s.date.toLocaleString() %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

</body>
</html>
