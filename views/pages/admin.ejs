<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Client Enquiries</title>
    <!-- Professional Typography: Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-zinc-900 text-zinc-100 antialiased selection:bg-blue-600 selection:text-white">
<div class="min-h-screen bg-zinc-900 flex flex-col relative">

    <!-- Top Navigation Bar -->
    <header class="bg-zinc-800/90 backdrop-blur-xl border-b border-zinc-700/80 sticky top-0 z-30 px-6 py-4 flex items-center justify-between shadow-2xl">
        <div class="flex items-center space-x-3">
            <img src="\\imgs\Smart Logo.jpg" alt="Smart Aqua Logo" class="h-10 w-10 rounded-xl object-cover shadow-lg shadow-blue-600/25">
            <div>
                <h1 class="text-lg font-bold tracking-tight text-white">Client Enquiries</h1>
                <p class="text-xs sm:text-sm font-semibold text-zinc-200 tracking-wide mt-0.5">Smart Aqua Infrastructure Dashboard</p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <span class="bg-blue-600/20 text-blue-400 border border-blue-500/30 text-[10px] uppercase px-2.5 py-1.5 rounded-xl font-bold tracking-wider hidden sm:inline-block shadow-inner">Live CRM</span>
            <div class="hidden sm:flex items-center text-xs text-zinc-300 bg-zinc-900 border border-zinc-700 px-3 py-1.5 rounded-xl shadow-inner">
                <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse mr-2"></span>
                System Operational
            </div>
            <a href="/admin/logout" class="inline-flex items-center gap-2 bg-zinc-700 hover:bg-zinc-600 text-zinc-200 border border-zinc-600 px-3.5 py-2 rounded-xl text-xs font-semibold transition-all duration-200 shadow-sm">
                <svg class="w-4 h-4 text-zinc-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                Logout
            </a>
        </div>
    </header>

    <!-- Main Workspace Area with minimal left/right margin (px-3 sm:px-6) -->
    <main class="flex-1 px-3 sm:px-6 py-6 w-full mx-auto space-y-6">

        <!-- Top Controls Grid: Compact Stats + Search & Filters with matching heights -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch">
            
            <!-- Compact Stats Overview Boxes -->
            <div class="lg:col-span-4 grid grid-cols-2 gap-3 h-full">
                <div class="bg-zinc-800/70 backdrop-blur-md border border-zinc-700/85 p-3.5 rounded-2xl shadow-lg flex items-center justify-between h-full">
                    <div>
                        <p class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider">Total Enquiries</p>
                        <h3 class="text-2xl font-extrabold text-white mt-0.5" id="totalCount"><%= submissions ? submissions.length : 0 %></h3>
                    </div>
                    <div class="h-9 w-9 rounded-lg bg-blue-600/10 border border-blue-500/20 flex items-center justify-center text-blue-400 shadow-inner shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                    </div>
                </div>
                
                <div class="bg-zinc-800/70 backdrop-blur-md border border-zinc-700/85 p-3.5 rounded-2xl shadow-lg flex items-center justify-between h-full">
                    <div>
                        <p class="text-[10px] font-semibold text-zinc-400 uppercase tracking-wider">Active Status</p>
                        <h3 class="text-2xl font-extrabold text-blue-400 mt-0.5">Synced</h3>
                    </div>
                    <div class="h-9 w-9 rounded-lg bg-zinc-700 border border-zinc-600 flex items-center justify-center text-blue-400 shadow-inner shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                    </div>
                </div>
            </div>

            <!-- Search & Filters Toolbar -->
            <div class="lg:col-span-8 bg-zinc-800/70 backdrop-blur-md border border-zinc-700/85 p-3 rounded-2xl shadow-lg flex flex-col sm:flex-row items-center gap-3 justify-end h-full">
                <div class="relative w-full sm:w-72">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-zinc-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </span>
                    <input type="text" id="searchInput" onkeyup="filterTable()" placeholder="Search name, phone, email..." class="w-full bg-zinc-900 border border-zinc-700 text-zinc-100 text-xs rounded-xl pl-9 pr-4 py-2.5 focus:outline-none focus:border-blue-500 transition-all placeholder:text-zinc-500">
                </div>

                <div class="w-full sm:w-48">
                    <select id="filterSelect" onchange="filterTable()" class="w-full bg-zinc-900 border border-zinc-700 text-zinc-300 text-xs rounded-xl px-3 py-2.5 focus:outline-none focus:border-blue-500 transition-all">
                        <option value="all">All Categories</option>
                        <option value="ro">RO Plants</option>
                        <option value="dm">DM Plants</option>
                        <option value="chiller">Chillers</option>
                        <option value="softener">Softeners</option>
                    </select>
                </div>
            </div>

        </div>

        <!-- Enquiries Table Container -->
        <div class="bg-zinc-800/80 backdrop-blur-md border border-zinc-700 rounded-2xl shadow-2xl overflow-hidden flex flex-col">
            <div class="p-4 border-b border-zinc-700 flex items-center justify-between gap-3 bg-zinc-800/50">
                <h2 class="text-sm font-bold text-white flex items-center gap-2">
                    <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                    Incoming Prospect Submissions
                </h2>
                <div class="hidden sm:flex items-center gap-2 text-[11px] text-zinc-400 bg-zinc-900 border border-zinc-700 px-3 py-1 rounded-lg">
                    <svg class="w-3.5 h-3.5 text-blue-500 animate-pulse" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Scroll horizontally to inspect details
                </div>
            </div>

            <div class="overflow-x-auto w-full">
                <table class="w-full text-left border-collapse whitespace-nowrap" id="enquiriesTable">
                    <thead class="bg-zinc-900 text-zinc-400 text-[11px] uppercase font-bold tracking-wider border-b border-zinc-700">
                        <tr>
                            <th class="py-4 px-5">Name</th>
                            <th class="py-4 px-5">Phone</th>
                            <th class="py-4 px-5">Email</th>
                            <th class="py-4 px-5">Address</th>
                            <th class="py-4 px-5">RO Plants</th>
                            <th class="py-4 px-5">DM Plants</th>
                            <th class="py-4 px-5">Chillers</th>
                            <th class="py-4 px-5">Softeners</th>
                            <th class="py-4 px-5">Custom Requirement</th>
                            <th class="py-4 px-5">Date</th>
                            <th class="py-4 px-5 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-700/65 text-sm text-zinc-200" id="tableBody">
                        <% if (submissions && submissions.length > 0) { %>
                            <% submissions.forEach(s => { %>
                            <tr class="enquiry-row hover:bg-zinc-700/45 transition-colors duration-150 align-top group" 
                                data-search="<%= (s.name + ' ' + s.phone + ' ' + (s.email || '') + ' ' + s.address).toLowerCase() %>"
                                data-ro="<%= Boolean(s.selections?.roPlants?.length) %>"
                                data-dm="<%= Boolean(s.selections?.dmPlants?.length) %>"
                                data-chiller="<%= Boolean(s.selections?.chillers?.length) %>"
                                data-softener="<%= Boolean(s.selections?.softeners?.length) %>">

                                <td class="py-4 px-5 font-bold text-white group-hover:text-blue-400 transition-colors"><%= s.name %></td>
                                <td class="py-4 px-5 text-zinc-300 font-mono"><%= s.phone %></td>
                                <td class="py-4 px-5">
                                    <% if (s.email) { %>
                                        <a href="mailto:<%= s.email %>" class="text-blue-400 hover:text-blue-300 hover:underline font-medium"><%= s.email %></a>
                                    <% } else { %>
                                        <span class="text-zinc-500 italic">N/A</span>
                                    <% } %>
                                </td>
                                <td class="py-4 px-5 text-zinc-300 max-w-xs truncate"><%= s.address %></td>

                                <% ['roPlants', 'dmPlants', 'chillers', 'softeners'].forEach((key, index) => { %>
                                    <td class="py-4 px-5 whitespace-normal">
                                        <% if (s.selections?.[key]?.length) { %>
                                            <div class="flex flex-wrap gap-1.5 max-w-xs">
                                                <% s.selections[key].forEach(v => { %>
                                                    <span class="<%= index === 0 ? 'bg-blue-600/20 border-blue-500/30 text-blue-300' : 'bg-zinc-700 border-zinc-600 text-zinc-200' %> border px-2 py-0.5 rounded-md text-xs font-medium"><%= v %></span>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <span class="text-zinc-500 italic">N/A</span>
                                        <% } %>
                                    </td>
                                <% }) %>

                                <td class="py-4 px-5 text-zinc-200 whitespace-normal max-w-xs">
                                    <% if (s.customRequirement?.trim()) { %>
                                        <div class="text-xs bg-zinc-900 p-2.5 rounded-xl border border-zinc-700 text-zinc-200 leading-relaxed shadow-inner"><%= s.customRequirement %></div>
                                    <% } else { %>
                                        <span class="text-zinc-500 italic">None</span>
                                    <% } %>
                                </td>

                                <td class="py-4 px-5 text-zinc-300 text-xs whitespace-nowrap"><%= s.date ? s.date.toDateString() : 'N/A' %></td>

                                <td class="py-4 px-5 text-right whitespace-nowrap">
                                    <form action="/delete/<%= s._id %>" method="POST">
                                        <button type="button" onclick="openDeleteModal(event)" class="bg-zinc-700 hover:bg-zinc-600 text-zinc-200 border border-zinc-600 px-3 py-1.5 rounded-xl font-semibold text-xs transition-all duration-150">Delete</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr id="emptyRow">
                                <td colspan="11" class="py-16 text-center text-zinc-500 italic">No client enquiries found in the database.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>
</div>

<!-- Custom Delete Confirmation Modal -->
<div id="deleteModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden">
    <div class="bg-zinc-800 border border-zinc-700 p-6 rounded-2xl shadow-2xl max-w-sm w-full mx-4 space-y-4">
        <div class="flex items-center space-x-3 text-red-400">
            <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <h3 class="text-base font-bold text-white tracking-tight">Confirm Deletion</h3>
        </div>
        <p class="text-xs text-zinc-300 leading-relaxed">Are you sure you want to delete this enquiry? This action cannot be undone.</p>
        <div class="flex items-center justify-end gap-2 pt-2">
            <button type="button" onclick="closeDeleteModal()" class="bg-zinc-700 hover:bg-zinc-600 text-zinc-200 px-4 py-2 rounded-xl text-xs font-semibold transition-all">Cancel</button>
            <button type="button" id="confirmDeleteBtn" class="bg-red-600 hover:bg-red-500 text-white px-4 py-2 rounded-xl text-xs font-semibold transition-all shadow-lg shadow-red-600/20">Yes, Delete</button>
        </div>
    </div>
</div>

<!-- JavaScript for Live Filtering, Searching, and Custom Modal -->
<script>
    let activeDeleteForm = null;

    function openDeleteModal(event) {
        event.preventDefault();
        activeDeleteForm = event.target.closest('form');
        document.getElementById('deleteModal').classList.remove('hidden');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
        activeDeleteForm = null;
    }

    document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
        if (activeDeleteForm) {
            activeDeleteForm.submit();
        }
    });

    function filterTable() {
        const searchInput = document.getElementById('searchInput').value.toLowerCase();
        const filterSelect = document.getElementById('filterSelect').value;
        const rows = document.querySelectorAll('.enquiry-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const matchesSearch = row.getAttribute('data-search').includes(searchInput);
            let matchesFilter = true;

            if (filterSelect !== 'all') {
                matchesFilter = row.getAttribute(`data-${filterSelect}`) === 'true';
            }

            if (matchesSearch && matchesFilter) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        document.getElementById('totalCount').innerText = visibleCount;
    }
</script>
</body>
</html>